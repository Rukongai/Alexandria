# Host ports used by Docker Compose
HTTP_PORT=80
BACKEND_PORT=3001
POSTGRES_PORT=5433
REDIS_PORT=6379
# Set this to a release version (for example, 1.2.0) to pin published images.
ALEXANDRIA_IMAGE_TAG=latest

# PostgreSQL credentials used by both the database container and backend.
POSTGRES_USER=alexandria
POSTGRES_PASSWORD=
POSTGRES_DB=alexandria

# Optional for host development; `npm run dev:up` derives it from the Postgres values.
# For hosted PostgreSQL, set this to the provider's connection string instead. See
# docs/HOSTED_DATABASE.md.
DATABASE_URL=
# DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
STORAGE_BACKEND=local
STORAGE_PATH=./data/storage
# Files uploaded in parallel to a remote backend (ignored for local storage)
STORAGE_UPLOAD_CONCURRENCY=8
# S3-compatible storage (required only when STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false
# Persistent local read-through cache for S3 thumbnails. Set max bytes to 0 to disable.
S3_THUMBNAIL_CACHE_MAX_BYTES=1073741824
# S3_THUMBNAIL_CACHE_PATH=./data/storage/.cache/s3-thumbnails
# The AWS SDK default credential chain is used. These variables are one option.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Required deployment secrets. Generate each value separately and keep it stable.
SESSION_SECRET=
AI_ENCRYPTION_KEY=
# Optional. Defaults true in development and false in production. Enable only for
# a trusted loopback/LAN provider; metadata and link-local targets stay blocked.
# AI_ALLOW_PRIVATE_PROVIDER_URLS=true
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
SEED_ADMIN_EMAIL=admin@alexandria.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Admin

# Local stdio MCP server. Set the UUID of the Alexandria account the server may
# act as. Omit the library UUID to use that account's default library. Downloads
# are confined beneath the configured directory.
ALEXANDRIA_MCP_USER_ID=
ALEXANDRIA_MCP_LIBRARY_ID=
ALEXANDRIA_MCP_DOWNLOAD_DIR=./data/mcp-downloads
