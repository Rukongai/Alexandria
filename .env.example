# Use port 5433 when running against docker-compose (maps to 5432 inside container)
DATABASE_URL=postgresql://alexandria:alexandria@localhost:5433/alexandria
# DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
STORAGE_BACKEND=local
STORAGE_PATH=./data/storage
# S3-compatible storage (required only when STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false
# The AWS SDK default credential chain is used. These variables are one option.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SESSION_SECRET=change-me-in-production
# Required in production: replace this placeholder with a stable, separate 32+ character secret.
AI_ENCRYPTION_KEY=change-me-to-a-separate-long-random-secret
# Optional. Defaults true in development and false in production. Enable only for
# a trusted loopback/LAN provider; metadata and link-local targets stay blocked.
# AI_ALLOW_PRIVATE_PROVIDER_URLS=true
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
SEED_ADMIN_EMAIL=admin@alexandria.local
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_DISPLAY_NAME=Admin
