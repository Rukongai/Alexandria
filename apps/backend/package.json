{
  "name": "@alexandria/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "postinstall": "node --input-type=commonjs -e \"require('fs').chmodSync(require('7zip-bin-full').path7z, 0o755)\"",
    "dev": "node --env-file=../../.env --import=tsx/esm --watch src/server.ts",
    "mcp": "if [ -f ../../.env ]; then exec node --env-file=../../.env --import=tsx/esm src/mcp/server.ts; else exec node --import=tsx/esm src/mcp/server.ts; fi",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "storage:migrate": "tsx src/scripts/migrate-storage.ts"
  },
  "dependencies": {
    "@alexandria/shared": "*",
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/lib-storage": "^3.1092.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/yauzl": "^2.10.3",
    "7zip-bin-full": "^26.2.1",
    "archiver": "^7.0.1",
    "argon2": "^0.41.0",
    "bullmq": "^5.70.1",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "ipaddr.js": "^2.4.0",
    "nanoid": "^5.0.0",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "re2-wasm": "^1.0.2",
    "sharp": "^0.34.5",
    "tar": "^7.5.9",
    "undici": "^6.27.0",
    "yauzl": "^3.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/node-7z": "^2.1.11",
    "@types/pg": "^8.11.0",
    "@types/sharp": "^0.31.1",
    "@types/tar": "^6.1.13",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
